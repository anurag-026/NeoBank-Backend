# Browser-visible (used by the SPA). Prefer Vite proxy paths in development.
VITE_API_BASE_URL=http://localhost:8080
VITE_AUTH_URL=http://localhost:9000
VITE_USE_DEV_PROXY=true

# Server-only for Vite dev proxy (NOT prefixed with VITE_ — not bundled into the client).
# Must match auth-service ClientConfig registered client.
OAUTH_CLIENT_ID=api-gateway
OAUTH_CLIENT_SECRET=secret123
